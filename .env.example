# Copy to .env (cp .env.example .env). All values below are local dev defaults.
POSTGRES_USER=closure
POSTGRES_PASSWORD=closure_dev_password
POSTGRES_DB=closure
# Compose gives the API the unprivileged role instead (closure_app, with APP_DB_PASSWORD), and the one-shot `migrate`
# service the owner's URL; this line matters only for a local run outside compose.
DATABASE_URL=postgresql://closure:closure_dev_password@postgres:5432/closure
# Password of the API's database role closure_app (api/migrations/009_app_role.sql); `migrate` sets it on every `make up`.
# APP_DB_PASSWORD=closure_app_dev_password

# HAPI FHIR R4 (service name inside the compose network)
FHIR_BASE_URL=http://fhir:8080/fhir

# Simulation clock: all timers run off this injectable "now"
SIM_CLOCK_START=2026-01-05T08:00:00Z
# CLOCK_MODE=sim (default) uses the simulation clock above; CLOCK_MODE=wall uses real UTC time, has no /clock routes and is
# required outside APP_ENV=dev (A30, ADR-041). Leader election (A31): LEADER_LEASE_TTL_SECONDS=30, REQUIRE_LEADER_FENCE=false;
# `make up-scale` runs two API replicas behind a proxy and two schedulers (docs/governance/operations.md).
# CLOCK_MODE=sim

# Watchdog: flag open cases with no events for this many days
WATCHDOG_IDLE_DAYS=7

# Drafting provider for patient-facing text. "template" = no model, fully offline.
LLM_PROVIDER=template

# Identity (ADR-012, ADR-029). The built-in defaults work only while APP_ENV=dev. Any other APP_ENV
# refuses to start unless DEV_LOGIN_ENABLED=false, DEV_AUTH_SECRET and all three service tokens are
# random strings of at least 32 bytes (`openssl rand -hex 32`), and the service tokens differ.
# The passwordless login and the /clock routes exist only in APP_ENV=dev.
APP_ENV=dev
# DEV_AUTH_SECRET=change-me-to-a-long-random-string  (>= 32 bytes)
# SCHEDULER_SERVICE_TOKEN=change-me-to-a-long-random-string
# DEV_LOGIN_ENABLED=true

# Closure evidence (A15): when true the API refuses `close` unless evidence_ref
# (DiagnosticReport/<id> or Procedure/<id>) exists in HAPI. Compose sets it to true.
# FHIR_VERIFY_EVIDENCE=true

# Service tokens (A11): the watchdog may emit only watchdog_flagged. Required outside APP_ENV=dev.
# WATCHDOG_SERVICE_TOKEN=change-me-to-a-long-random-string

# The automation actor (A21, ADR-032): `system:automation` acknowledges and assigns on ingest, re-routes rejected referrals,
# sends the pre-approved messages in config/outreach_policy.yaml and proposes closures from evidence it finds. It never
# closes a case. AUTOMATION_ENABLED defaults to true in compose and false for a bare API; the service token is required
# outside APP_ENV=dev like the other two (>= 32 bytes, not the default, all three different).
# AUTOMATION_ENABLED=true
# The shipped outreach policy (config/outreach_policy.yaml) is unsigned (approved_by: null) and an unsigned policy sends nothing.
# Compose sets OUTREACH_DEMO_APPROVAL=1 so the demo can show the automatic messages under "DEMO PLACEHOLDER (clinical sign-off
# pending, H1)", with a banner in the web app. The API refuses to start with it on outside APP_ENV=dev. Set it to 0 to see the
# automation hold its messages back.
# OUTREACH_DEMO_APPROVAL=1
# AUTOMATION_SERVICE_TOKEN=change-me-to-a-long-random-string

# Browser origins allowed to call the API (E8), comma separated. Default: the local web app on 5173, 4173 and 4175.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# The HL7 v2 adapter (A28, ADR-039): `system:hl7` may POST /hl7 (and the optional MLLP listener, compose profile `hl7`, uses
# the same token) and nothing else. Optional: empty switches it off; set outside APP_ENV=dev it must be >= 32 random bytes.
# HL7_SERVICE_TOKEN=change-me-to-a-long-random-string
# HL7_PATIENT_ID_SYSTEM=SCREENING-CLOSURE   # PID-3 assigning authority that carries the Patient id

# Identity mode (A29, ADR-040): dev (HMAC dev-login, tokens last 8 h) or oidc (JWTs from an OIDC provider; required outside
# APP_ENV=dev). `make oidc-up` starts the local Keycloak and sets oidc for the compose API. Demo passwords are generated per
# run into .oidc-demo-credentials; set KC_PW_COORDINATOR etc. here to choose your own. Never commit them.
# AUTH_MODE=dev
# OIDC_ISSUER=http://localhost:8180/realms/screening-closure
# OIDC_AUDIENCE=screening-closure
# DEV_TOKEN_LIFETIME_SECONDS=28800
