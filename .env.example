# Copy to .env (cp .env.example .env). All values below are local dev defaults.
POSTGRES_USER=closure
POSTGRES_PASSWORD=closure_dev_password
POSTGRES_DB=closure
DATABASE_URL=postgresql://closure:closure_dev_password@postgres:5432/closure

# HAPI FHIR R4 (service name inside the compose network)
FHIR_BASE_URL=http://fhir:8080/fhir

# Simulation clock: all timers run off this injectable "now"
SIM_CLOCK_START=2026-01-05T08:00:00Z

# Watchdog: flag open cases with no events for this many days
WATCHDOG_IDLE_DAYS=7

# Drafting provider for patient-facing text. "template" = no model, fully offline.
LLM_PROVIDER=template

# Identity (ADR-012). The built-in defaults work only while APP_ENV=dev; any other APP_ENV
# refuses to start until both values below are replaced with long random strings.
APP_ENV=dev
# DEV_AUTH_SECRET=change-me-to-a-long-random-string
# SCHEDULER_SERVICE_TOKEN=change-me-to-a-long-random-string
# DEV_LOGIN_ENABLED=true

# Closure evidence (A15): when true the API refuses `close` unless evidence_ref
# (DiagnosticReport/<id> or Procedure/<id>) exists in HAPI. Compose sets it to true.
# FHIR_VERIFY_EVIDENCE=true

# Service tokens (A11): the watchdog may emit only watchdog_flagged. Required outside APP_ENV=dev.
# WATCHDOG_SERVICE_TOKEN=change-me-to-a-long-random-string

# Browser origins allowed to call the API (E8), comma separated. Default: the local web app on 5173, 4173 and 4175.
# CORS_ALLOW_ORIGINS=http://localhost:5173
