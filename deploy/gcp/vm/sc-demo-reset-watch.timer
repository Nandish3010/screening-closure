# EXAMPLE timer (ADR-058): look for a reset request every 15 s. The scheduled reset is a second timer calling
# `demo-reset-watch.sh --scheduled` every 6 h (OnUnitActiveSec=6h, Persistent=true); see the PR notes.
[Unit]
Description=Look for a demo reset request every 15 seconds

[Timer]
OnBootSec=60
OnUnitActiveSec=15
AccuracySec=1

[Install]
WantedBy=timers.target
