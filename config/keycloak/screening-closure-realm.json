{
  "realm": "screening-closure",
  "enabled": true,
  "displayName": "Screening Closure (UAE PASS stand-in)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      {
        "name": "lab",
        "description": "Screening Closure role: lab"
      },
      {
        "name": "primary_care_owner",
        "description": "Screening Closure role: primary_care_owner"
      },
      {
        "name": "specialist_owner",
        "description": "Screening Closure role: specialist_owner"
      },
      {
        "name": "coordinator",
        "description": "Screening Closure role: coordinator"
      },
      {
        "name": "patient",
        "description": "Screening Closure role: patient"
      },
      {
        "name": "supervisor",
        "description": "Screening Closure role: supervisor"
      }
    ]
  },
  "clients": [
    {
      "clientId": "screening-closure-web",
      "name": "Screening Closure web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*",
        "http://localhost:4175/*",
        "http://127.0.0.1:4175/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:4173",
        "http://127.0.0.1:4173",
        "http://localhost:4175",
        "http://127.0.0.1:4175"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "screening-closure",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "full-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "provider",
            "claim.name": "provider",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "patient_ref",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "patient_ref",
            "claim.name": "patient_ref",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "lab.intake",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Lab",
      "lastName": "Intake",
      "email": "lab.intake@demo.invalid",
      "attributes": {},
      "realmRoles": [
        "lab"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${KC_PW_LAB}",
          "temporary": false
        }
      ]
    },
    {
