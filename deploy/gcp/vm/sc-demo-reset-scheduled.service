# Unit (ADR-058), installed and enabled by deploy/gcp/vm/sc-up.sh. the scheduled reset. Pair with sc-demo-reset-scheduled.timer.
[Unit]
Description=Scheduled reset of the judge demo to its seeded snapshot (ADR-058)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/srv/sc/repo/deploy/gcp/vm/demo-reset-watch.sh --scheduled
TimeoutStartSec=300
