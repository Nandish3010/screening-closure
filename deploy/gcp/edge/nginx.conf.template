# Rendered by the official nginx image (envsubst, only variables starting with SC_). Listens on 8080 inside the network; Caddy is in front.
limit_req_zone $binary_remote_addr zone=api_ip:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=login_ip:10m rate=5r/s;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=conn_ip:10m;


server {
    listen 8080;
    server_name _;
    server_tokens off;
    # Caddy (on the private compose network) is the only client nginx sees; take the visitor's address from its X-Forwarded-For so
    # the rate limits are per visitor, not one shared bucket.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 10.0.0.0/8;
    real_ip_header X-Forwarded-For;
    client_max_body_size 256k;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    # --- the API, under /api (prefix stripped). Service, scrape, clock and HL7 paths are never public. -----------------------
    location ~ ^/api/(scheduler|watchdog|hl7)(/|$) { return 404; }
    # FastAPI's interactive docs and schema map every route; the app disables them in production, and the edge refuses them too.
    location ~ ^/api/(docs|redoc|openapi\.json)(/|$) { return 404; }
    # Demo clock: only "advance" (supervisor token, checked by the API); reset and anything else under /clock stay closed.
    location = /api/clock/advance {
        limit_req zone=api_ip burst=5 nodelay;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
    }
    location ~ ^/api/clock { return 404; }
    # Demo controls that move shared state (ADR-058): supervisor token, checked by the API, which also rate limits a reset; the edge adds a tight burst.
    location ~ ^/api/demo/(reset|missed-followup)$ {
        limit_req zone=api_ip burst=3 nodelay;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }
    # One-click demo sign-in (ADR-060): public by design, so the edge allows few and the API adds a per-address limit of its own. The
    # visitor's address is passed in X-Forwarded-For (overwritten here, so a client cannot choose its own bucket in the API).
    location = /api/demo/sign-in {
        limit_req zone=login_ip burst=5 nodelay;
        limit_conn conn_ip 5;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
    location = /api/metrics { return 404; }
    location = /api/auth/dev-login { return 404; }          # 404 in production anyway; refuse it before the API sees it
    location /api/ {
        limit_req zone=api_ip burst=40 nodelay;
        limit_conn conn_ip 30;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    # --- Keycloak (judge sign-in) under /auth. The admin console and the master realm are not public. ------------------------
    location ~ ^/auth/(admin|realms/master) { return 404; }
    location /auth/ {
        limit_req zone=login_ip burst=20 nodelay;
        proxy_pass http://keycloak-prod:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
    }

    # --- the static web app (single page; unknown paths fall back to index.html) -------------------------------------------------
    # Content-Security-Policy for the web app only (not /auth: Keycloak's login pages send their own policy and need inline script, and
    # a second header would intersect with it). Verified against the production build (web/dist): one external module script, no inline
    # script, self-hosted fonts and icons, same-origin API (/api) and Keycloak (/auth) calls; React sets style attributes, hence
    # 'unsafe-inline' for style only. data:/blob: images are the QR/PNG and download blobs. nginx drops server-level add_header lines in a
    # location that sets its own, so the three above are repeated here.
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    }
    location = /sw.js { root /usr/share/nginx/html; add_header Cache-Control "no-cache"; }
    location = /healthz { access_log off; return 200 "ok\n"; }
}
